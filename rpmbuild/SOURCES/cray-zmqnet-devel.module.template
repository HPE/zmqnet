conflict <CRAY_NAME>

set ZMQNET_LEVEL        <VERSION>
set ZMQNET_BASEDIR      <PREFIX>

setenv ZMQNET_DEVEL_VERSION            $ZMQNET_LEVEL
setenv LIBZMQNET_DEVEL_VERSION         $ZMQNET_LEVEL
setenv CRAY_ZMQNET_DEVEL_VERSION       $ZMQNET_LEVEL
setenv CRAY_LIBZMQNET_DEVEL_VERSION    $ZMQNET_LEVEL

setenv PE_ZMQNET_DEVEL_MODULE_NAME     <CRAY_NAME>

prepend-path PE_PKGCONFIG_PRODUCTS PE_ZMQNET
prepend-path PKG_CONFIG_PATH $ZMQNET_BASEDIR/lib/pkgconfig
prepend-path PKG_CONFIG_PATH $ZMQNET_BASEDIR/support/lib/pkgconfig

if { [ file exists ${ZMQNET_BASEDIR}/release_info ] } {
      set REL_INFO [ exec cat ${ZMQNET_BASEDIR}/release_info ]
   } else {
      set REL_INFO ""
   }

proc ModulesHelp { } {
   global ZMQNET_BASEDIR
   global ZMQNET_LEVEL
   global REL_INFO
   puts stderr "The modulefile defines the system paths and"
   puts stderr "variables development components of the product <CRAY_NAME>."
   puts stderr "$REL_INFO"
   puts stderr "============================================="
   puts stderr "To re-display <CRAY_NAME>/$ZMQNET_LEVEL release information,"
   puts stderr "type:    less $ZMQNET_BASEDIR/release_info"
   puts stderr "==============================================\n"
   puts stderr ""
}

module-whatis   "Loads pkg-config content for the Cray zmqnet library."

if {[is-loaded <CRAY_BASE_NAME>]} {
    module unload <CRAY_BASE_NAME>
}

module load <CRAY_BASE_NAME>/$ZMQNET_LEVEL
