#%Module######################################################################
#
#       Module <CRAY_NAME>
#       <COPYRIGHT>
#       UNPUBLISHED PROPRIETARY INFORMATION.
#       ALL RIGHTS RESERVED.
#
conflict <CRAY_NAME>

set ZMQNET_LEVEL        <VERSION>
set ZMQNET_BASEDIR      <PREFIX>

setenv ZMQNET_VERSION            $ZMQNET_LEVEL
setenv LIBZMQNET_VERSION         $ZMQNET_LEVEL
setenv CRAY_ZMQNET_VERSION       $ZMQNET_LEVEL
setenv CRAY_LIBZMQNET_VERSION    $ZMQNET_LEVEL

setenv ZMQNET_INSTALL_DIR        $ZMQNET_BASEDIR
setenv LIBZMQNET_INSTALL_DIR     $ZMQNET_BASEDIR
setenv CRAY_ZMQNET_PREFIX        $ZMQNET_BASEDIR
setenv CRAY_LIBZMQNET_PREFIX     $ZMQNET_BASEDIR

setenv PE_ZMQNET_MODULE_NAME  <CRAY_NAME>

prepend-path CRAY_LD_LIBRARY_PATH $ZMQNET_BASEDIR/lib
prepend-path LD_LIBRARY_PATH $ZMQNET_BASEDIR/lib

if { [ file exists ${ZMQNET_BASEDIR}/release_notes.md ] } {
      set REL_INFO [ exec cat ${ZMQNET_BASEDIR}/release_notes.md ]
   } else {
      set REL_INFO ""
   }

proc ModulesHelp { } {
   global ZMQNET_BASEDIR
   global ZMQNET_LEVEL
   global REL_INFO
   puts stderr "The modulefile defines the system paths and"
   puts stderr "variables for the product <CRAY_NAME>."
   puts stderr "$REL_INFO"
   puts stderr "============================================="
   puts stderr "To re-display <CRAY_NAME>/$ZMQNET_LEVEL release information,"
   puts stderr "type:    less $ZMQNET_BASEDIR/release_info"
   puts stderr "==============================================\n"
   puts stderr ""
}

module-whatis   "Loads the Cray zmqnet library."
