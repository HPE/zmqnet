prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libzmqnet
Description: libzmqnet
Version: @PACKAGE_VERSION@
Libs: -L${libdir} -lzmq -lzmqnet -Wl,-rpath,${libdir} -pthread
Libs.private: -lsupc++
Cflags: -I${includedir}
