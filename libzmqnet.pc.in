prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@
supportdir=${prefix}/support

cpe_libarg=-L${libdir} -L${supportdir}/lib 
default_libarg=-L${libdir}


Name: libzmqnet
Description: libzmqnet
Version: @PACKAGE_VERSION@
Libs: ${default_libarg} -lzmqnet -lzmq -lkj -lcapnp -lLrleBitset -pthread
Libs.private: -lsupc++
Cflags: -I${includedir} -I${supportdir}/include
