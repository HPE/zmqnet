prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@
supportdir=${prefix}/support

Name: libzmqnet
Description: libzmqnet
Version: @PACKAGE_VERSION@
Libs: -L${supportdir}/lib -lzmq -lkj -lcapnp -Wl,-rpath,${supportdir}/lib -L${libdir} -lzmqnet -Wl,-rpath,${libdir} -pthread
Libs.private: -lsupc++
Cflags: -I${includedir} -I${supportdir}/include
