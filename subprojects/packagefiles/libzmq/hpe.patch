diff --git a/src/random.cpp b/src/random.cpp
index 07022910..b422d88e 100644
--- a/src/random.cpp
+++ b/src/random.cpp
@@ -17,6 +17,8 @@
 #include "sodium.h"
 #endif
 
+#include <stdexcept>
+
 void zmq::seed_random ()
 {
 #if defined ZMQ_HAVE_WINDOWS
@@ -27,11 +29,42 @@ void zmq::seed_random ()
     srand (static_cast<unsigned int> (clock_t::now_us () + pid));
 }
 
+// CPE-8040: multiple calls to `rand` will corrupt the stack on SLES 15 SP6 x86
+static uint32_t generate_random_r ()
+{
+    // Use local stack buffer with `random_r` instead of corrupting global buffer
+    char state_buffer[256];
+    struct random_data r_data;
+    int32_t low, high;
+
+    // initstate_r will dereference state in r_data unless it is zero-initialized
+    memset(&r_data, 0x0, sizeof(r_data));
+
+    auto pid = static_cast<int>(getpid ());
+    auto seed = static_cast<unsigned int>(zmq::clock_t::now_us() + pid);
+    if (initstate_r(seed, state_buffer, sizeof(state_buffer), &r_data) != 0) {
+        throw std::runtime_error("initstate_r failed.");
+    }
+
+    if ((random_r(&r_data, &low)) != 0 || (random_r(&r_data, &high) != 0)) {
+        throw std::runtime_error("random_r failed.");
+    }
+
+    high <<= (sizeof (int) * 8 - 1);
+    return high | low;
+}
+
 uint32_t zmq::generate_random ()
 {
+    // CPE-8040: multiple calls to `rand` will corrupt the stack on SLES 15 SP6 x86
+    if (::getenv("ZMQ_CPE_8040_DISABLE") == nullptr) {
+        return generate_random_r();
+    }
+
     //  Compensate for the fact that rand() returns signed integer.
     const uint32_t low = static_cast<uint32_t> (rand ());
     uint32_t high = static_cast<uint32_t> (rand ());
+
     high <<= (sizeof (int) * 8 - 1);
     return high | low;
 }
